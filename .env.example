# Backend base URLs — must match `PORT` in hubtrub-backend/.env (default 9000).
# The React client uses these for HTTP/WS, and forwards them into the Godot
# iframe via postMessage(SET_CONNECTION_CONFIG → apiBaseUrl / wsBaseUrl).
VITE_API_URL=http://localhost:9000
VITE_WS_URL=ws://localhost:9000

# Firebase web SDK. The client trades the ID token for a hub_session cookie
# via POST /auth/session, so these are public-by-design.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
